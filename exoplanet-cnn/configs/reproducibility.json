{
  "_comment": "Reproducibility snapshot of the code defaults. The CLIs are the source of truth; tests/test_config_snapshot.py fails if this file and the code disagree.",
  "seed": {
    "download_target_sampling": 42,
    "dataset_split": 42,
    "training": 42,
    "optuna_sampler": 42,
    "baselines": 42
  },
  "download": {
    "module": "src.data.download_kepler",
    "dispositions": ["CONFIRMED", "FALSE POSITIVE"],
    "label": "CONFIRMED = 1, FALSE POSITIVE = 0 (per KOI)",
    "exptime": "long",
    "development_sample": "--limit 100 per disposition, --seed 42 -> 200 stars in data/raw_small"
  },
  "views": {
    "module": "src.preprocessing.views (ViewConfig); written to data/processed/views/views_config.json",
    "flux_column": "PDCSAP_FLUX",
    "quality_bitmask": 0,
    "detrend_window_days": 1.0,
    "gap_days": 0.5,
    "transit_mask_factor": 1.0,
    "sigma_upper": 3.0,
    "global_bins": 2001,
    "local_bins": 201,
    "local_bin_width_factor": 0.16,
    "local_num_durations": 4.0,
    "normalization": "shared"
  },
  "split": {
    "module": "src.data.build_dataset",
    "train": 0.7,
    "val": 0.15,
    "test": 0.15,
    "grouped_by": "kepid (stratified by the star's max label)"
  },
  "cnn": {
    "module": "src.models.astronet_style.AstronetStyle",
    "global_channels": [16, 32, 64, 128, 256],
    "local_channels": [16, 32],
    "kernel_size": 5,
    "convs_per_block": 2,
    "global_pool": [5, 2],
    "local_pool": [7, 2],
    "hidden": [512, 512, 512, 512],
    "dropout": 0.0,
    "batch_norm": false,
    "output": "raw logit (N,); sigmoid only for metrics / predict_proba"
  },
  "training": {
    "module": "src.training.train",
    "model": "astronet",
    "optimizer": "AdamW",
    "lr": 0.0001,
    "weight_decay": 0.0001,
    "batch_size": 64,
    "epochs": 50,
    "grad_clip": 0.0,
    "loss": "weighted_bce",
    "pos_weight": "auto",
    "pos_weight_formula": "n_negative / n_positive of the TRAIN split only",
    "scheduler": "plateau",
    "scheduler_patience": 3,
    "monitor_default": "val_pr_auc",
    "monitor_recommended": "val_pr_auc",
    "patience": 10,
    "min_delta": 0.0001
  },
  "evaluation": {
    "primary_metric": "PR-AUC (average precision)",
    "threshold_selection": "max F1 on the VALIDATION split, stored in best.pt",
    "test_guard": "--split test requires --final-test"
  },
  "optuna": {
    "module": "src.training.hyperparameter_search",
    "objective": "validation PR-AUC (maximize)",
    "sampler": "TPESampler",
    "pruner": "MedianPruner(n_startup_trials=5)",
    "n_trials": 30,
    "pruner_warmup_epochs": 5,
    "storage": "sqlite",
    "search_space": {
      "lr": [1e-05, 0.01],
      "dropout": [0.0, 0.5],
      "kernel_size": [3, 5, 7, 9],
      "batch_size": [16, 32, 64, 128],
      "base_filters": [8, 16, 32]
    }
  },
  "baselines": {
    "module": "src.baselines.compare",
    "feature_set": "engineered",
    "random_forest_n_estimators": 500,
    "xgboost_max_depth": 3,
    "bootstrap": 1000
  },
  "vetting": {
    "module": "src.inference.vetting (VettingConfig)",
    "max_odd_even_sigma": 3.0,
    "max_secondary_snr": 3.0,
    "max_v_shape": 1.3,
    "max_depth_ppm": 30000.0,
    "max_harmonic_dll": 0.0,
    "min_snr": 7.1,
    "min_transits": 3,
    "max_single_event_frac": 0.5,
    "max_oot_dip": 0.5,
    "max_asymmetry": 0.25,
    "max_oot_noise": 0.3,
    "min_local_coverage": 0.5,
    "min_transit_evidence": 0.3,
    "high_confidence": 0.6,
    "low_confidence": 0.25
  }
}
